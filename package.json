{
  "name": "voice-studio",
  "version": "1.1.0",
  "description": "Real-time voice changer and vocal-processing studio for Windows",
  "main": "main.js",
  "homepage": "https://github.com/jamimmehdi/voice-studio",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jamimmehdi/voice-studio.git"
  },
  "bugs": {
    "url": "https://github.com/jamimmehdi/voice-studio/issues"
  },
  "scripts": {
    "start": "electron .",
    "test": "node test/dsp.test.js",
    "preview": "node tools/serve.js",
    "icon": "node tools/make-icon.js",
    "dist": "electron-builder --win --publish never"
  },
  "keywords": [
    "voice-changer",
    "audio",
    "electron",
    "windows",
    "dsp"
  ],
  "author": {
    "name": "Jamim Mehdi",
    "email": "jamimmehdi.sec@gmail.com"
  },
  "license": "MIT",
  "type": "commonjs",
  "devDependencies": {
    "electron": "^44.7.2",
    "electron-builder": "^26.15.3",
    "png-to-ico": "^3.0.2",
    "sharp": "^0.35.5"
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  },
  "build": {
    "appId": "com.voicestudio.app",
    "productName": "Voice Studio",
    "copyright": "Copyright © 2026 Jamim Mehdi",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "src/**/*",
      "build/icon.png",
      "package.json"
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "jamimmehdi",
        "repo": "voice-studio"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico",
      "signAndEditExecutable": true,
      "signExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "artifactName": "Voice-Studio-Setup-${version}.${ext}",
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Voice Studio",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico"
    }
  }
}
